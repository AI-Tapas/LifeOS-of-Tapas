# Copy to .env.local for local dev. Get local Supabase values from: supabase status
# For production (Vercel), use the Supabase cloud project's values.

# --- Supabase -------------------------------------------------------------
# Supabase project URL (local: http://127.0.0.1:54321)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon (publishable) key. Safe for the client; RLS protects data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key. SERVER SIDE ONLY, never expose to the client and never
# set it as a NEXT_PUBLIC_ variable. From Milestone 2 the server needs it to
# read/write OAuth tokens in Vault (lib/supabase/service.ts) and by
# scripts/rls.test.mjs. On Vercel set it as a plain (non-public) env var.
SUPABASE_SERVICE_ROLE_KEY=

# --- App ------------------------------------------------------------------
# Public base URL of this app. Used to build OAuth redirect URIs, so it must
# exactly match what is registered in the Google/Microsoft consoles.
# Local: http://localhost:3000  (use localhost, not 127.0.0.1). Prod: the Vercel URL.
APP_BASE_URL=http://localhost:3000

# --- Google OAuth (app-level account connections, not Supabase sign-in) ----
# Two clients are mandatory: an Internal-audience client cannot serve accounts
# outside its org, so the Internal client serves Tax Strategia and the External
# client serves the consumer (ca.tapasnr) and icai.org accounts.
#
# Client A: Internal audience, Tax Strategia org project, client ID marked
# Trusted in the Workspace Admin console.
GOOGLE_INTERNAL_CLIENT_ID=
GOOGLE_INTERNAL_CLIENT_SECRET=
# Client B: External audience, publishing status Production, deliberately
# unverified (personal-use exception; click through the warning once).
GOOGLE_EXTERNAL_CLIENT_ID=
GOOGLE_EXTERNAL_CLIENT_SECRET=

# --- Microsoft OAuth -------------------------------------------------------
# Altechon single-tenant Entra app registration (delegated permissions, admin
# consent already granted). Tenant id pins sign-in to the Altechon tenant.
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=

# --- RLS test against the cloud (npm run test:rls:cloud) -------------------
# scripts/rls.test.mjs reads these non-prefixed aliases when set, instead of
# asking the local CLI stack. Point them at the cloud project to prove RLS
# there: SUPABASE_URL is the project URL, SUPABASE_ANON_KEY the publishable
# (sb_publishable_...) key; SUPABASE_SERVICE_ROLE_KEY above (sb_secret_...) is
# also required. Run: npm run test:rls:cloud (loads .env.local via --env-file).
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- MCP connector --------------------------------------------------------
# Shared secret for /api/mcp, which lets Claude or ChatGPT drive the
# assistant through mcp-server/. Server-side only; at least 24 characters,
# or the route refuses every request. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# The same value goes in the MCP client's env as LIFEOS_MCP_TOKEN.
LIFEOS_MCP_TOKEN=

# --- Cron (Milestone 5) -----------------------------------------------------
# Shared secret for the two Vercel Cron routes (/api/cron/scan, /api/cron/
# brief). Vercel sends it as "Authorization: Bearer $CRON_SECRET" when this
# var is set on the project; server-side only, at least 24 characters, same
# rule as LIFEOS_MCP_TOKEN above. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Set it in Vercel's project settings, not just here, or the crons 401.
CRON_SECRET=

# --- Assistant LLM (Milestone 4) -------------------------------------------
# Server-side only; never NEXT_PUBLIC_. On Vercel set these as plain env
# vars. Keys for several providers can be stored side by side: LLM_PROVIDER
# alone decides which is live, so switching never means re-pasting a key.

# Which provider is live: anthropic (default), nvidia or deepseek.
LLM_PROVIDER=

# Anthropic preset (Messages API, keeps prompt caching and thinking).
ANTHROPIC_API_KEY=
# Optional model override. Default: claude-opus-5
ANTHROPIC_MODEL=

# NVIDIA Build preset (OpenAI-style Chat Completions).
NVIDIA_API_KEY=
# Optional model override. Use the exact id from the model page, which is
# the same as its build.nvidia.com path, e.g. z-ai/glm-5.2 or
# deepseek-ai/deepseek-v4-flash-0731. Default: z-ai/glm-5.2
NVIDIA_MODEL=

# DeepSeek platform preset (OpenAI-style Chat Completions).
DEEPSEEK_API_KEY=
# Optional model override: deepseek-v4-flash (default) or deepseek-v4-pro.
DEEPSEEK_MODEL=

# Generic escape hatch for any other host (OpenRouter, Groq, DeepSeek,
# Ollama, LiteLLM, Z.ai). These override the preset when set.
# LLM_API_FORMAT: anthropic or openai. For openai the base URL must include
# the version path, e.g. https://openrouter.ai/api/v1
LLM_API_FORMAT=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Optional: LLM_MAX_TOKENS (default 4096); LLM_THINKING=off for anthropic
# hosts that reject the thinking parameter; LLM_STRICT=off for openai hosts
# that reject strict tool schemas.
